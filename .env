# Where the API runs during development. The API's "https" launch profile listens on https://localhost:7221
# (its http port 5041 only redirects to https). With the "http" profile use http://localhost:5041 instead.
VITE_API_PROXY_TARGET=https://localhost:7221

# Base URL the app calls. Keep "/api" in development (goes through the Vite proxy).
# In production set it to the deployed API, e.g. https://api.mylibrary.com/api
VITE_API_BASE_URL=/api
